# Local preparation defaults. One instance, behind an HTTPS reverse proxy in production.
HOST=127.0.0.1
PORT=5207
PUBLIC_ORIGIN=http://127.0.0.1:5207
DATABASE_PATH=./data/league.sqlite
# Optional: trust one known proxy socket address, and only its overwritten IP header.
TRUSTED_PROXY_IP=
PROXY_CLIENT_IP_HEADER=x-real-ip
# Real OAuth stays disabled until Riot approves this League service's own RSO client.
RIOT_LEAGUE_RSO_APPROVED=false
RIOT_LEAGUE_RSO_CLIENT_ID=
# Private secret files must be issued for this League service, never copied from VALORANT.
RIOT_LEAGUE_RSO_CLIENT_SECRET_FILE=
RIOT_LEAGUE_API_KEY_FILE=
# These must describe the actual operator before enabling account linking.
OPERATOR_NAME=
OPERATOR_CONTACT=
PRIVACY_URL=
TERMS_URL=
# Outbound budget shared by all profiles. Set within this League key's assigned limits.
RIOT_LEAGUE_REQUESTS_PER_MINUTE=60
MAX_PROFILES=1000
